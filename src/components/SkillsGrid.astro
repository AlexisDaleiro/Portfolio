---
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang).stack;
---

<section id="stack" aria-labelledby="stack-title" class="border-t border-subtle py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-2xl">
      <h2 id="stack-title" class="text-balance font-display text-3xl font-bold tracking-tight sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.intro}</p>
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-subtle bg-subtle md:grid-cols-3">
      {
        t.groups.map((group, i) => (
          <div class="reveal bg-surface p-7 sm:p-9" style={`--d:${i * 90}ms`}>
            <h3 class="font-display text-xl font-semibold">{group.title}</h3>
            <p class="mt-3 text-muted">{group.benefit}</p>
            <ul class="mt-6 flex flex-wrap gap-2">
              {group.items.map((item) => <li class="chip">{item}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
