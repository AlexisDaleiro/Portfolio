---
import Icon from './Icon.astro';
import { getDict, wa, CONTACT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const dict = getDict(lang);
const t = dict.contact;
---

<section id="contacto" aria-labelledby="contacto-title" class="border-t border-subtle py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal max-w-3xl">
      <h2 id="contacto-title" class="text-balance font-display text-3xl font-bold tracking-tight sm:text-5xl">
        {t.title}
      </h2>
      <p class="mt-4 text-lg text-muted">{t.text}</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-12 lg:gap-12">
      <form
        id="contact-form"
        class="reveal min-w-0 space-y-5 rounded-2xl border border-subtle bg-surface p-6 sm:p-8 lg:col-span-7"
        data-wa={`https://wa.me/${CONTACT.waNumber}`}
        data-template={t.form.greeting}
        data-endpoint={CONTACT.formspreeId ? `https://formspree.io/f/${CONTACT.formspreeId}` : ''}
        data-mailto={CONTACT.email}
        data-sending={t.form.sending}
        data-sent={t.form.sent}
        data-error={t.form.error}
      >
        <div role="group" aria-label={t.form.channel} class="flex w-fit items-center rounded-xl border border-subtle bg-canvas p-0.5 font-mono text-xs font-medium">
          <button
            type="button"
            data-mode="whatsapp"
            data-submit={t.form.submit}
            data-hint={t.form.hint}
            aria-pressed="true"
            class="inline-flex h-9 items-center gap-1.5 rounded-[0.6rem] px-3 text-muted transition-colors hover:text-primary aria-pressed:bg-accent-emerald aria-pressed:text-[#0A0C10]"
          >
            <Icon name="whatsapp" size={16} />WhatsApp
          </button>
          <button
            type="button"
            data-mode="email"
            data-submit={t.form.submitEmail}
            data-hint={t.form.hintEmail}
            aria-pressed="false"
            class="inline-flex h-9 items-center gap-1.5 rounded-[0.6rem] px-3 text-muted transition-colors hover:text-primary aria-pressed:bg-accent-emerald aria-pressed:text-[#0A0C10]"
          >
            <Icon name="mail" size={16} />Email
          </button>
        </div>
        <div>
          <label for="c-name" class="mb-2 block text-sm font-medium">{t.form.name}</label>
          <input
            id="c-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            maxlength="80"
            placeholder={t.form.namePlaceholder}
            class="field"
          />
        </div>
        <div>
          <label for="c-email" class="mb-2 block text-sm font-medium">{t.form.email}</label>
          <input
            id="c-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            maxlength="120"
            placeholder={t.form.emailPlaceholder}
            class="field"
          />
        </div>
        <div>
          <label for="c-idea" class="mb-2 block text-sm font-medium">{t.form.idea}</label>
          <textarea
            id="c-idea"
            name="idea"
            required
            rows="5"
            maxlength="1000"
            placeholder={t.form.ideaPlaceholder}
            class="field resize-y"></textarea>
        </div>
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
          <button type="submit" class="btn btn-primary" data-submit-btn>
            <span data-icon="whatsapp"><Icon name="whatsapp" size={18} /></span>
            <span data-icon="email" hidden><Icon name="mail" size={18} /></span>
            <span data-submit-label>{t.form.submit}</span>
          </button>
          <p class="text-sm text-muted" data-hint>{t.form.hint}</p>
        </div>
        <p role="status" class="text-sm font-medium" data-status></p>
      </form>

      <div class="reveal min-w-0 space-y-4 lg:col-span-5" style="--d:90ms">
        <h3 class="font-display text-lg font-semibold">{t.directTitle}</h3>
        <a
          href={wa(t.waMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary w-full flex-wrap justify-between gap-x-4 gap-y-1 !py-3"
        >
          <span class="inline-flex items-center gap-2">
            <Icon name="whatsapp" size={18} />
            {t.whatsapp}
          </span>
          <span class="font-mono text-xs font-medium">{CONTACT.phoneDisplay}</span>
          <span class="sr-only">{dict.a11y.external}</span>
        </a>

        <div class="relative flex items-center justify-between gap-3 rounded-xl border border-subtle bg-surface py-2.5 pl-4 pr-2.5">
          <span class="flex min-w-0 items-center gap-2.5">
            <Icon name="mail" size={18} class="shrink-0 text-muted" />
            <span class="truncate font-mono text-sm" id="email-text">{CONTACT.email}</span>
          </span>
          <button
            type="button"
            class="btn btn-ghost !min-h-10 shrink-0 !px-3"
            data-copy={CONTACT.email}
            data-copied={t.copied}
            data-failed={t.copyFailed}
            aria-label={t.copy}
          >
            <Icon name="copy" size={16} />
            <span class="hidden sm:inline">{t.copy}</span>
          </button>
          <span class="copy-tip" role="status" data-tip></span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <a
            href={CONTACT.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            <Icon name="linkedin" size={18} />
            {t.linkedin}
            <span class="sr-only">{dict.a11y.external}</span>
          </a>
          <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <Icon name="github" size={18} />
            {t.github}
            <span class="sr-only">{dict.a11y.external}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const modeBtns = form?.querySelectorAll<HTMLButtonElement>('[data-mode]') ?? [];
  const submitBtn = form?.querySelector<HTMLButtonElement>('[data-submit-btn]');
  const submitLabel = form?.querySelector<HTMLElement>('[data-submit-label]');
  const hint = form?.querySelector<HTMLElement>('p[data-hint]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  let mode: 'whatsapp' | 'email' = 'whatsapp';

  const setMode = (next: 'whatsapp' | 'email') => {
    mode = next;
    modeBtns.forEach((btn) => {
      const on = btn.dataset.mode === next;
      btn.setAttribute('aria-pressed', String(on));
      if (on) {
        if (submitLabel) submitLabel.textContent = btn.dataset.submit ?? '';
        if (hint) hint.textContent = btn.dataset.hint ?? '';
      }
    });
    form?.querySelectorAll<HTMLElement>('[data-icon]').forEach((el) => {
      el.hidden = el.dataset.icon !== next;
    });
    if (status) status.textContent = '';
  };
  modeBtns.forEach((btn) => btn.addEventListener('click', () => setMode(btn.dataset.mode as typeof mode)));

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const name = String(data.get('name')).trim();
    const email = String(data.get('email')).trim();
    const idea = String(data.get('idea')).trim();

    if (mode === 'whatsapp') {
      const text = (form.dataset.template ?? '')
        .replace('{name}', name)
        .replace('{email}', email)
        .replace('{idea}', idea);
      window.open(`${form.dataset.wa}?text=${encodeURIComponent(text)}`, '_blank', 'noopener,noreferrer');
      return;
    }

    if (!form.dataset.endpoint) {
      // ponytail: sin Formspree configurado, el modo email cae a mailto:
      const body = `${idea}\n\n— ${name} (${email})`;
      window.location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent('Portfolio: ' + name)}&body=${encodeURIComponent(body)}`;
      return;
    }

    data.append('_subject', `Portfolio: ${name}`);
    if (submitBtn) submitBtn.disabled = true;
    if (status) {
      status.className = 'text-sm font-medium text-muted';
      status.textContent = form.dataset.sending ?? '';
    }
    try {
      const res = await fetch(form.dataset.endpoint, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      if (status) {
        status.className = 'text-sm font-medium text-accent-emerald';
        status.textContent = form.dataset.sent ?? '';
      }
    } catch {
      if (status) {
        status.className = 'text-sm font-medium text-[#F87171]';
        status.textContent = form.dataset.error ?? '';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });

  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const tip = document.querySelector<HTMLElement>('[data-tip]');
  let timer: number | undefined;

  const flash = (message: string) => {
    if (!tip) return;
    tip.textContent = message;
    tip.classList.add('show');
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      tip.classList.remove('show');
      tip.textContent = '';
    }, 1800);
  };

  copyBtn?.addEventListener('click', async () => {
    const value = copyBtn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(value);
      flash(copyBtn.dataset.copied ?? '');
    } catch {
      flash(copyBtn.dataset.failed ?? '');
    }
  });
</script>
